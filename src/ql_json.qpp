    - @ref jsonserialization
    - @ref JSONRPC
 */
string makeJSONRPCRequestString(string method_name, auto version, auto id, auto request_msg) [flags=RET_VALUE_ONLY,DEPRECATED] {
    if (!version.isNullOrNothing()) {
