#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern
# child programs do not inherit parent's restrictions
%no-child-restrictions
# test deprecated functions as well
%disable-warning deprecated

# make sure we have the right version of qore
%requires qore >= 1.0

# make sure we have the json module
%requires json

%requires QUnit

%exec-class JsonTest

class JsonTest inherits QUnit::Test {
    public {}

    private {
        const TestHash = {
            "key1": 1,
            "key2": "string-\"test-quotes\"",
            "key3": 1.0391,
            "list": (1, 2, 3, ("four": 4), 5.1, True, ("key1": "one", "key2": 2.1)),
            "hash": ("test1": 123, "test2": 456),
            "bool": True,
            "time": now().format("YYYY-MM-DD HH:mm:SS"),
            "key": "this & that",
            "escapes": "lorem ipsum\ndolor\tsir amet",
            "\"key\"": 1,
            "null": NOTHING,
            "arr": (NOTHING,),
        };

        const TestDate = 2018-03-10T05:17:18Z;
    }

    constructor() : Test("JsonTest", "1.0", \ARGV) {
        addTestCase("formatting test", \formattingTest());
        addTestCase("float rounding test", \floatRoundingTest());
        addTestCase("scientific notation test", \scientificNotationTest());
        addTestCase("issue 3135", \issue3135());
        addTestCase("JsonTestCase", \jsonTestCase());
        addTestCase("JSON-RPC TestCase", \jsonRpcTestCase());
        addTestCase("JSON-RPC 1.1 TestCase", \jsonRpc11TestCase());
        addTestCase("JsonDeprecatedTestCase", \jsonDeprecatedTestCase());
        addTestCase("parse_json UTF-8/Unicode BOM skipping test", \parseJsonBom());
        addTestCase("issue 2655", \issue2655());
        addTestCase("JSON Pointer test", \jsonPointerTest());
        addTestCase("deeply nested structures", \testDeeplyNested());
        addTestCase("sandbox depth limit parse_json", \testSandboxDepthLimitParse());
        addTestCase("sandbox depth limit make_json", \testSandboxDepthLimitMake());
        addTestCase("sandbox interrupt parse_json", \testSandboxInterruptParse());
        addTestCase("sandbox interrupt make_json", \testSandboxInterruptMake());
        set_return_value(main());
    }

    formattingTest() {
        hash<auto> h = {
            "contact": {
                "email": "email@gmail.com",
                "codes": (1, "two",),
            },
        };
        string expected = "{\n  \"contact\": {\n    \"email\": \"email@gmail.com\",\n    \"codes\": [\n      1,\n"
            "      \"two\"\n    ]\n  }\n}";
        string json = make_json(h, JGF_ADD_FORMATTING);
        assertEq(expected, json);
        assertEq(h, parse_json(json));
    }

    floatRoundingTest() {
        assertEq("1.1", trim(make_json(1.1)));
        assertEq("1.2", trim(make_json(1.2)));
        assertEq("1.3", trim(make_json(1.3)));
        assertEq("250.1912", trim(make_json(250.1912)));
    }

    scientificNotationTest() {
        # basic scientific notation
        assertEq(30.0, parse_json("3E1"));
        assertEq(30.0, parse_json("3e1"));
        # scientific notation with explicit positive exponent
        assertEq(30.0, parse_json("3e+1"));
        assertEq(30.0, parse_json("3E+1"));
        assertEq(3e+10, parse_json("3e+10"));
        assertEq(3E+10, parse_json("3E+10"));
        # scientific notation with negative exponent
        assertEq(3e-10, parse_json("3e-10"));
        assertEq(3E-10, parse_json("3E-10"));
        assertEq(0.3, parse_json("3e-1"));
        assertEq(0.3, parse_json("3E-1"));
        # negative numbers with scientific notation
        assertEq(-3e10, parse_json("-3e10"));
        assertEq(-3e-10, parse_json("-3e-10"));
        assertEq(-3e+10, parse_json("-3e+10"));
        # floats with scientific notation
        assertEq(3.14e2, parse_json("3.14e2"));
        assertEq(3.14e-2, parse_json("3.14e-2"));
        assertEq(3.14e+2, parse_json("3.14e+2"));
        # error cases
        assertThrows("JSON-PARSE-ERROR", \parse_json(), "3e1e2");
    }

    issue3135() {
        assertEq("\"PT1S250000u\"", make_json(1s + 250ms));
        assertEq("\"P2M3DT10H14u\"", make_json(P2M3DT10H14u));
        assertEq("\"P10Y4M200DT99H140S\"", make_json(P10Y4M200DT99H140S));

        assertEq(PT1S250000u, date(parse_json("\"PT1S250000u\"")));
        assertEq(P2M3DT10H14u, date(parse_json("\"P2M3DT10H14u\"")));
        assertEq(P10Y4M200DT99H140S, date(parse_json("\"P10Y4M200DT99H140S\"")));
    }

    jsonTestCase() {
        assertEqSoft(TestHash, parse_json(make_json(TestHash)));
        assertEqSoft(TestHash, parse_json(make_json(TestHash, JGF_ADD_FORMATTING)));
        # issue #3707
        assertEq(30.0, parse_json("3E1"));
        assertEq(30.0, parse_json("3e1"));
        assertThrows("JSON-PARSE-ERROR", \parse_json(), "3e1e2");
        assertThrows("JSON-PARSE-ERROR", \parse_json(), "3e1E2");
        assertThrows("JSON-PARSE-ERROR", \parse_json(), "3E1e2");
        assertThrows("JSON-PARSE-ERROR", \parse_json(), "3E1E2");
    }

    jsonRpcTestCase() {
        int id = 512;
        string method = "methodname";

        hash jc = {
            "id": id,
            "method": method,
            "params": TestHash,
        };

        # JSON-RPC 1.0 messages
        assertEq(jc, parse_json(make_jsonrpc_request(method, NOTHING, id, TestHash)));
        assertEq(jc, parse_json(make_jsonrpc_request(method, "1.0", id, TestHash)));
        assertEq(jc, parse_json(make_jsonrpc_request(method, NOTHING, id, TestHash, JGF_ADD_FORMATTING)));
        assertEq(jc, parse_json(make_jsonrpc_request(method, "1.0", id, TestHash, JGF_ADD_FORMATTING)));

        hash jr = jc - ("method", "params") + ("result": TestHash);
        assertEq(jr, parse_json(make_jsonrpc_response(NOTHING, id, TestHash)));
        assertEq(jr, parse_json(make_jsonrpc_response("1.0", id, TestHash)));
        assertEq(jr, parse_json(make_jsonrpc_response(NOTHING, id, TestHash, JGF_ADD_FORMATTING)));
        assertEq(jr, parse_json(make_jsonrpc_response("1.0", id, TestHash, JGF_ADD_FORMATTING)));

        # create error hash by modifying the result hash: delete "result" key and add "error" key
        hash je = jr - "result" + ("error": TestHash);
        assertEq(je, parse_json(make_jsonrpc_error(NOTHING, id, TestHash)));
        assertEq(je, parse_json(make_jsonrpc_error("1.0", id, TestHash)));
        assertEq(je, parse_json(make_jsonrpc_error(NOTHING, id, TestHash, JGF_ADD_FORMATTING)));
        assertEq(je, parse_json(make_jsonrpc_error("1.0", id, TestHash, JGF_ADD_FORMATTING)));

        jc."jsonrpc" = "2.0";

        # JSON-RPC 2.0 messages
        assertEq(jc, parse_json(make_jsonrpc_request(method, "2.0", id, TestHash)));
        assertEq(jc, parse_json(make_jsonrpc_request(method, "2.0", id, TestHash, JGF_ADD_FORMATTING)));

        jr = jc - ("method", "params") + ("result": TestHash);
        assertEq(jr, parse_json(make_jsonrpc_response("2.0", id, TestHash)));
        assertEq(jr, parse_json(make_jsonrpc_response("2.0", id, TestHash, JGF_ADD_FORMATTING)));

        # create error hash by modifying the result hash: delete "result" key and add "error" key
        je = jr - "result" + ("error": TestHash);
        assertEq(je, parse_json(make_jsonrpc_error("2.0", id, TestHash)));
        assertEq(je, parse_json(make_jsonrpc_error("2.0", id, TestHash, JGF_ADD_FORMATTING)));
    }

    jsonRpc11TestCase() {
        string ver = "1.1";
        int id = 512;
        string method = "methodname";

        hash jc = {
            "version": ver,
            "id": id,
            "method": method,
            "params": TestHash,
        };

        # non-standard, non-published JSON-RPC 1.1 messages
        assertEq(jc, parse_json(make_jsonrpc_request(method, ver, id, TestHash)));
        assertEq(jc, parse_json(make_jsonrpc_request(method, ver, id, TestHash, JGF_ADD_FORMATTING)));

        # create result hash by modifying the call hash above: delete "method" and "params" keys and add "result" key
        hash jr = jc - "method" - "params" + ("result": TestHash);
        assertEq(jr, parse_json(make_jsonrpc_response(ver, id, TestHash)));
        assertEq(jr, parse_json(make_jsonrpc_response(ver, id, TestHash, JGF_ADD_FORMATTING)));

        # create error hash by modifying the result hash: delete "result" key and add "error" key
        hash je = jr - "result" + ("error": TestHash);
        assertEq(je, parse_json(make_jsonrpc_error(ver, id, TestHash)));
        assertEq(je, parse_json(make_jsonrpc_error(ver, id, TestHash, JGF_ADD_FORMATTING)));
    }

    jsonDeprecatedTestCase() {
        string jstr = makeJSONString(TestHash);
        assertEq(True, TestHash == parseJSON(jstr));

        string ver = "1.1";
        int id = 512;
        string method = "methodname";
        string mess = "error description test";

        hash jc = (
            "version": ver,
            "id": id,
            "method": method,
            "params": TestHash,
            );

        assertEq(jc, parseJSON(makeJSONRPCRequestString(method, ver, id, TestHash)));
        assertEq(jc, parseJSON(makeFormattedJSONRPCRequestString(method, ver, id, TestHash)));

        # create result hash by modifying the call hash above: delete "method" and "params" keys and add "result" key
        hash jr = jc - "method" - "params" + ("result": TestHash);
        assertEq(jr, parseJSON(makeJSONRPCResponseString(ver, id, TestHash)));
        assertEq(jr, parseJSON(makeFormattedJSONRPCResponseString(ver, id, TestHash)));

        # create error hash by modifying the result hash: delete "result" key and add "error" key
        hash je = jr - "result" + ("error": TestHash);
        assertEq(je, parseJSON(makeJSONRPCErrorString(ver, id, TestHash)));
        assertEq(je, parseJSON(makeFormattedJSONRPCErrorString(ver, id, TestHash)));

        # create JSON-RPC 1.1 error string
        je = je + ("error": ("name": "JSONRPCError", "code": id, "message": mess, "error": TestHash));
        assertEq(je, parse_json(make_jsonrpc11_error(id, mess, id, TestHash)));
        assertEq(je, parse_json(make_jsonrpc11_error(id, mess, id, TestHash, JGF_ADD_FORMATTING)));
        assertEq(je, parseJSON(makeJSONRPC11ErrorString(id, mess, id, TestHash)));
        assertEq(je, parseJSON(makeFormattedJSONRPC11ErrorString(id, mess, id, TestHash)));
    }

    parseJsonBom() {
        string data = make_json(TestHash);
        binary b = binary(data);
        string dataWithUtf8BOM = (<efbbbf> + b).toString("UTF-8");
        string dataWithFEFFBOM = (<feff> + b).toString("UTF-8");
        string dataWithFFFEBOM = (<fffe> + b).toString("UTF-8");

        assertEqSoft(TestHash, parse_json(dataWithUtf8BOM));
        assertEqSoft(TestHash, parse_json(dataWithFEFFBOM));
        assertEqSoft(TestHash, parse_json(dataWithFFFEBOM));
        assertEqSoft(TestHash, parseJSON(dataWithUtf8BOM));
        assertEqSoft(TestHash, parseJSON(dataWithFEFFBOM));
        assertEqSoft(TestHash, parseJSON(dataWithFFFEBOM));
    }

    issue2655() {
        # the json module serializes all dates to the current time zone
        TimeZone tz = TimeZone::get();
        # get a string for the test date in this time zone
        string datestr = tz.date(TestDate).format("YYYY-MM-DDTHH:mm:SS.usZ");
        string json = make_json(TestDate);

        # transform "Z" at the end into "+00:00" because that's the format that Qore generates
        if (json[json.length()-2] == "Z") {
            json = json.substr(0, json.length()-2) + "+00:00\"";
        }

        assertEq("\"" + datestr + "\"", json);
    }

    jsonPointerTest() {
        # test data
        hash<auto> data = {
            "foo": {
                "bar": (1, 2, 3),
                "baz": "hello",
            },
            "a/b": "slash",
            "c~d": "tilde",
            "empty": "",
            "null": NOTHING,
        };

        # json_pointer_get - basic usage
        assertEq(data, json_pointer_get(data, ""));
        assertEq(data.foo, json_pointer_get(data, "/foo"));
        assertEq(data.foo.bar, json_pointer_get(data, "/foo/bar"));
        assertEq(1, json_pointer_get(data, "/foo/bar/0"));
        assertEq(2, json_pointer_get(data, "/foo/bar/1"));
        assertEq(3, json_pointer_get(data, "/foo/bar/2"));
        assertEq("hello", json_pointer_get(data, "/foo/baz"));
        assertEq("", json_pointer_get(data, "/empty"));
        assertEq(NOTHING, json_pointer_get(data, "/null"));

        # json_pointer_get - escaped characters
        assertEq("slash", json_pointer_get(data, "/a~1b"));
        assertEq("tilde", json_pointer_get(data, "/c~0d"));

        # json_pointer_get - non-existent paths
        assertEq(NOTHING, json_pointer_get(data, "/nonexistent"));
        assertEq(NOTHING, json_pointer_get(data, "/foo/nonexistent"));
        assertEq(NOTHING, json_pointer_get(data, "/foo/bar/99"));

        # json_pointer_exists
        assertTrue(json_pointer_exists(data, ""));
        assertTrue(json_pointer_exists(data, "/foo"));
        assertTrue(json_pointer_exists(data, "/foo/bar"));
        assertTrue(json_pointer_exists(data, "/foo/bar/0"));
        assertTrue(json_pointer_exists(data, "/null"));
        assertFalse(json_pointer_exists(data, "/nonexistent"));
        assertFalse(json_pointer_exists(data, "/foo/bar/99"));

        # json_pointer_escape
        assertEq("foo", json_pointer_escape("foo"));
        assertEq("a~1b", json_pointer_escape("a/b"));
        assertEq("c~0d", json_pointer_escape("c~d"));
        assertEq("a~1b~0c", json_pointer_escape("a/b~c"));

        # error cases
        assertThrows("JSON-POINTER-ERROR", \json_pointer_get(), (data, "no-leading-slash"));
        assertThrows("JSON-POINTER-ERROR", \json_pointer_exists(), (data, "no-slash"));
    }

    #! Test parsing and serialization of deeply nested structures
    /** Without a sandbox, arbitrary nesting depth is allowed.
        This test verifies that moderate nesting works correctly for both
        parse_json() and make_json().
    */
    testDeeplyNested() {
        # Test round-trip for moderately nested structures
        hash<auto> nested50 = makeNestedHash(50);
        string json50 = make_json(nested50);
        hash<auto> parsed50 = parse_json(json50);
        assertEq(nested50, parsed50, "50-level nested structure should round-trip correctly");

        hash<auto> nested100 = makeNestedHash(100);
        string json100 = make_json(nested100);
        hash<auto> parsed100 = parse_json(json100);
        assertEq(nested100, parsed100, "100-level nested structure should round-trip correctly");

        # Test with formatted output (more complex structure)
        string formatted = make_json(nested50, JGF_ADD_FORMATTING);
        hash<auto> parsedFormatted = parse_json(formatted);
        assertEq(nested50, parsedFormatted, "Formatted 50-level nested structure should round-trip correctly");

        # Test deeply nested arrays
        list<auto> nestedList50 = makeNestedList(50);
        string listJson = make_json(nestedList50);
        list<auto> parsedList = parse_json(listJson);
        assertEq(nestedList50, parsedList, "50-level nested list should round-trip correctly");
    }

    private static hash<auto> makeNestedHash(int depth) {
        hash<auto> result = {"value": depth};
        for (int i = depth - 1; i >= 0; i--) {
            result = {"nested": result, "level": i};
        }
        return result;
    }

    private static list<auto> makeNestedList(int depth) {
        list<auto> result = (depth,);
        for (int i = depth - 1; i >= 0; i--) {
            result = (result, i);
        }
        return result;
    }

    #! Test that parse_json enforces depth limit when sandbox is active
    testSandboxDepthLimitParse() {
        # Create JSON with exactly 256 levels of nesting (should succeed)
        string json256 = makeNestedJsonString(256);
        # Create JSON with 257 levels of nesting (should fail)
        string json257 = makeNestedJsonString(257);

        # Test in sandboxed program
        string code = "
%new-style
%require-types
%strict-args
%requires json

auto sub test(string json_str) {
    return parse_json(json_str);
}
";
        Program p(PO_NEW_STYLE | PO_REQUIRE_TYPES | PO_STRICT_ARGS);
        p.setSandboxManager(new SandboxManager());
        p.parse(code, "sandbox-test");

        # 256 levels should succeed
        auto result = p.callFunction("test", json256);
        assertTrue(exists result, "256 levels of nesting should be allowed in sandbox");

        # 257 levels should fail with depth error
        assertThrows("JSON-PARSE-ERROR", "depth", \p.callFunction(), ("test", json257));
    }

    #! Test that make_json enforces depth limit when sandbox is active
    testSandboxDepthLimitMake() {
        # makeNestedHash(n) creates n+1 containers, so use 255 for 256 containers
        # Create data with exactly 256 levels of nesting (should succeed)
        hash<auto> data256 = makeNestedHash(255);
        # Create data with 257 levels of nesting (should fail)
        hash<auto> data257 = makeNestedHash(256);

        # Test in sandboxed program
        string code = "
%new-style
%require-types
%strict-args
%requires json

string sub test(auto data) {
    return make_json(data);
}
";
        Program p(PO_NEW_STYLE | PO_REQUIRE_TYPES | PO_STRICT_ARGS);
        p.setSandboxManager(new SandboxManager());
        p.parse(code, "sandbox-test");

        # 256 levels should succeed
        auto result = p.callFunction("test", data256);
        assertTrue(exists result, "256 levels of nesting should be allowed in sandbox for make_json");

        # 257 levels should fail with depth error
        assertThrows("JSON-SERIALIZATION-ERROR", "depth", \p.callFunction(), ("test", data257));
    }

    #! Test that parse_json honors interrupt requests in sandbox mode
    testSandboxInterruptParse() {
        # Create JSON with many elements to trigger interrupt check (interval is 100)
        string largeJson = makeLargeJsonArray(200);

        # Test in sandboxed program with pre-requested interrupt
        string code = "
%new-style
%require-types
%strict-args
%requires json

auto sub test(string json_str) {
    return parse_json(json_str);
}
";
        Program p(PO_NEW_STYLE | PO_REQUIRE_TYPES | PO_STRICT_ARGS);
        SandboxManager sm();
        p.setSandboxManager(sm);
        p.parse(code, "sandbox-test");

        # Request interrupt before parsing - the interrupt check will catch it
        sm.requestInterrupt();

        # Should fail with PROGRAM-INTERRUPTED error
        assertThrows("PROGRAM-INTERRUPTED", \p.callFunction(), ("test", largeJson));
    }

    #! Test that make_json honors interrupt requests in sandbox mode
    testSandboxInterruptMake() {
        # Create data with many elements to trigger interrupt check (interval is 100)
        list<int> largeList = ();
        for (int i = 0; i < 200; i++) {
            push largeList, i;
        }

        # Test in sandboxed program with pre-requested interrupt
        string code = "
%new-style
%require-types
%strict-args
%requires json

string sub test(auto data) {
    return make_json(data);
}
";
        Program p(PO_NEW_STYLE | PO_REQUIRE_TYPES | PO_STRICT_ARGS);
        SandboxManager sm();
        p.setSandboxManager(sm);
        p.parse(code, "sandbox-test");

        # Request interrupt before serializing - the interrupt check will catch it
        sm.requestInterrupt();

        # Should fail with PROGRAM-INTERRUPTED error
        assertThrows("PROGRAM-INTERRUPTED", \p.callFunction(), ("test", largeList));
    }

    #! Helper to create a large JSON array string
    private static string makeLargeJsonArray(int count) {
        list<string> items = ();
        for (int i = 0; i < count; i++) {
            push items, sprintf("%d", i);
        }
        return "[" + items.join(",") + "]";
    }

    #! Helper to create deeply nested JSON string
    private static string makeNestedJsonString(int depth) {
        string open = "";
        string close = "";
        for (int i = 0; i < depth; i++) {
            open += "{\"a\":";
            close += "}";
        }
        return open + "1" + close;
    }
}
