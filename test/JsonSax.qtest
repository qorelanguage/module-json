#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%new-style
%strict-args
%enable-all-warnings
%require-types

%requires qore >= 2.0
%requires json
%requires QUnit

%exec-class JsonSaxTest

class JsonSaxTest inherits QUnit::Test {
    public {}

    private {
        const SimpleObject = '{"name": "Alice", "age": 30}';
        const SimpleArray = '[1, 2, 3]';
        const NestedStructure = '{"users": [{"name": "Alice"}, {"name": "Bob"}], "count": 2}';
        const MixedValues = '{"str": "hello", "num": 42, "float": 3.14, "bool": true, "null": null}';
        const EscapedStrings = "{\"text\": \"hello\\nworld\", \"unicode\": \"\\u0041\"}";
    }

    constructor() : Test("JsonSaxTest", "1.0", \ARGV) {
        addTestCase("SAX parser basic object", \testBasicObject());
        addTestCase("SAX parser basic array", \testBasicArray());
        addTestCase("SAX parser nested structure", \testNestedStructure());
        addTestCase("SAX parser mixed values", \testMixedValues());
        addTestCase("SAX parser escaped strings", \testEscapedStrings());
        addTestCase("SAX parser empty input", \testEmptyInput());
        addTestCase("SAX parser error handling", \testErrorHandling());
        # TODO: Fix parseStream implementation
        # addTestCase("SAX parser stream input", \testStreamInput());
        addTestCase("SAX parser large data", \testLargeData());
        addTestCase("SAX event constants", \testEventConstants());
        set_return_value(main());
    }

    testBasicObject() {
        JsonSaxParser parser();
        list<hash<auto>> events = ();
        parser.parse(SimpleObject, sub(hash<auto> e) { push events, e; });
        assertGe(5, events.size());
        assertEq(JsonSaxObjectStart, events[0].type);
        assertEq(JsonSaxObjectEnd, events[events.size() - 1].type);
    }

    testBasicArray() {
        JsonSaxParser parser();
        list<hash<auto>> events = ();
        parser.parse(SimpleArray, sub(hash<auto> e) { push events, e; });
        assertGe(5, events.size());
        assertEq(JsonSaxArrayStart, events[0].type);
        assertEq(JsonSaxArrayEnd, events[events.size() - 1].type);
        int number_count = 0;
        foreach hash<auto> e in (events) {
            if (e.type == JsonSaxNumber) {
                number_count++;
            }
        }
        assertEq(3, number_count);
    }

    testNestedStructure() {
        JsonSaxParser parser();
        list<hash<auto>> events = ();
        parser.parse(NestedStructure, sub(hash<auto> e) { push events, e; });

        # Count object/array events
        int object_starts = 0;
        int object_ends = 0;
        int array_starts = 0;
        int array_ends = 0;

        foreach hash<auto> e in (events) {
            switch (e.type) {
                case JsonSaxObjectStart: object_starts++; break;
                case JsonSaxObjectEnd: object_ends++; break;
                case JsonSaxArrayStart: array_starts++; break;
                case JsonSaxArrayEnd: array_ends++; break;
            }
        }

        assertEq(3, object_starts, "Should have 3 object starts");
        assertEq(3, object_ends, "Should have 3 object ends");
        assertEq(1, array_starts, "Should have 1 array start");
        assertEq(1, array_ends, "Should have 1 array end");
    }

    testMixedValues() {
        JsonSaxParser parser();
        list<hash<auto>> events = ();
        parser.parse(MixedValues, sub(hash<auto> e) { push events, e; });

        # Check for different value types
        bool has_string = False;
        bool has_number = False;
        bool has_boolean = False;
        bool has_null = False;

        foreach hash<auto> e in (events) {
            switch (e.type) {
                case JsonSaxString: has_string = True; break;
                case JsonSaxNumber: has_number = True; break;
                case JsonSaxBoolean: has_boolean = True; break;
                case JsonSaxNull: has_null = True; break;
            }
        }

        assertTrue(has_string, "Should have string value");
        assertTrue(has_number, "Should have number value");
        assertTrue(has_boolean, "Should have boolean value");
        assertTrue(has_null, "Should have null value");
    }

    testEscapedStrings() {
        JsonSaxParser parser();
        list<hash<auto>> events = ();
        parser.parse(EscapedStrings, sub(hash<auto> e) { push events, e; });

        # Find string values
        list<string> string_values = ();
        foreach hash<auto> e in (events) {
            if (e.type == JsonSaxString) {
                push string_values, e.value;
            }
        }

        assertGe(2, string_values.size());
        # Check that newline was properly unescaped
        assertRegex("\n", string_values[0]);
        # Check that unicode was properly decoded
        assertEq("A", string_values[1]);
    }

    testEmptyInput() {
        JsonSaxParser parser();
        list<hash<auto>> events = ();

        # Empty string should not throw and produce no events
        parser.parse("", sub(hash<auto> e) { push events, e; });
        assertEq(0, events.size());

        # Whitespace only should also be fine
        events = ();
        parser.parse("   \n\t  ", sub(hash<auto> e) { push events, e; });
        assertEq(0, events.size());
    }

    testErrorHandling() {
        JsonSaxParser parser();

        # Invalid JSON should throw
        assertThrows("JSON-SAX-PARSE-ERROR", sub() {
            parser.parse("{invalid}", sub(hash<auto> e) { });
        });

        assertThrows("JSON-SAX-PARSE-ERROR", sub() {
            parser.parse('{"key": }', sub(hash<auto> e) { });
        });
    }

    testStreamInput() {
        JsonSaxParser parser();
        list<hash<auto>> events = ();

        StringInputStream sis(SimpleObject);
        parser.parseStream(sis, sub(hash<auto> e) { push events, e; });

        assertGt(0, events.size());

        # Verify first event is object start
        assertEq(JsonSaxObjectStart, events[0].type);
    }

    testLargeData() {
        # Create a large JSON array
        list<hash<auto>> items = ();
        for (int i = 0; i < 100; i++) {
            push items, {"id": i, "value": sprintf("item-%d", i)};
        }
        string large_json = make_json(items);

        JsonSaxParser parser();
        int event_count = 0;
        int number_count = 0;
        int string_count = 0;

        parser.parse(large_json, sub(hash<auto> e) {
            event_count++;
            if (e.type == JsonSaxNumber) {
                number_count++;
            } else if (e.type == JsonSaxString) {
                string_count++;
            }
        });

        # Should have many events
        assertGt(100, event_count);
        assertEq(100, number_count, "Should have 100 id numbers");
        assertEq(100, string_count, "Should have 100 value strings");
    }

    testEventConstants() {
        # Verify constants are defined
        assertTrue(exists JsonSaxObjectStart);
        assertTrue(exists JsonSaxObjectEnd);
        assertTrue(exists JsonSaxArrayStart);
        assertTrue(exists JsonSaxArrayEnd);
        assertTrue(exists JsonSaxKey);
        assertTrue(exists JsonSaxString);
        assertTrue(exists JsonSaxNumber);
        assertTrue(exists JsonSaxBoolean);
        assertTrue(exists JsonSaxNull);

        # Verify they are all different
        hash<string, bool> seen();
        list<int> constants = (
            JsonSaxObjectStart,
            JsonSaxObjectEnd,
            JsonSaxArrayStart,
            JsonSaxArrayEnd,
            JsonSaxKey,
            JsonSaxString,
            JsonSaxNumber,
            JsonSaxBoolean,
            JsonSaxNull,
        );

        foreach int c in (constants) {
            string key = sprintf("%d", c);
            assertFalse(seen{key} ?? False, sprintf("Constant value %d should be unique", c));
            seen{key} = True;
        }
    }
}
