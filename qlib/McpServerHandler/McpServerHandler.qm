# minimum qore version
%requires qore >= 2.0
%requires json
%requires Mime
%requires Util
%requires HttpServerUtil
%requires ServerSentEventHandler
%requires JsonRpcHandler
%requires Logger
%requires DataProvider
%try-module uuid
%define NoUuid
%endtry

# don't use "$" for vars, members, and method calls, assume local var scope
%new-style
%require-types
%enable-all-warnings
%strict-args

module McpServerHandler {
    version = "1.0";
    desc = "McpServerHandler module for use with the Qore HttpServer module";
    author = "David Nichols <david@qore.org>";
    url = "http://qore.org";
    license = "MIT";
}

/** @mainpage McpServer Module

    @tableofcontents

    @section McpServerintro Introduction to the McpServer Module

    This module implements support for an MCP server

    @section McpServer_relnotes McpServer Release Notes

    @subsection McpServer_1_0 McpServer v1.0
    - initial release
*/

#! the %McpServerHandler namespace holds all public definitions in the %McpServerHandler module
public namespace McpServerHandler {
#! Server name
public const McpServerName = "QoreMcpServer";

#! Server version
public const McpServerVersion = "1.0";
}
